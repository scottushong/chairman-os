# dummy | live
# dummy 일 때만 화면에 DUMMY DATA 뱃지가 뜬다. 실데이터가 붙으면 live 로 바꾼다.
# live 인데 아래 Supabase 키가 비어 있으면 앱이 시작 시 에러를 던진다(조용히 dummy로 떨어지지 않는다).
NEXT_PUBLIC_DATA_MODE=dummy

# --- Supabase (Phase 1) -------------------------------------------------
# 프로젝트 생성 후 Chairman이 직접 채운다. 실제 값은 커밋하지 않는다(.env.local 만 사용).
# Dashboard > Project Settings > API 에서 그대로 복사한다.

# 프로젝트 URL. 예: https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon public key. 브라우저에 노출돼도 되는 값이다.
# 행 단위 접근은 전부 RLS(supabase/migrations/0002_rls.sql)가 판정한다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key. RLS를 통째로 우회하므로 서버 런타임에서만 쓴다.
# NEXT_PUBLIC_ 접두사를 절대 붙이지 않는다 — 붙이는 순간 브라우저로 나간다.
# 야간 AI Job(CH-045~048)과 마이그레이션 스크립트 전용.
SUPABASE_SERVICE_ROLE_KEY=

# DB 직접 접속 비밀번호. 마이그레이션(supabase db push) 실행용.
# 애플리케이션 런타임은 이 값을 쓰지 않는다(05_Architecture 6. Production DB 직접 접근 금지).
SUPABASE_DB_PASSWORD=
