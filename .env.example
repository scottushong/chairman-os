# dummy | live
# dummy 일 때만 화면에 DUMMY DATA 뱃지가 뜬다. 실데이터가 붙으면 live 로 바꾼다.
# live 인데 아래 Supabase 키가 비어 있으면 앱이 시작 시 에러를 던진다(조용히 dummy로 떨어지지 않는다).
NEXT_PUBLIC_DATA_MODE=dummy

# Deployment identity, independent of dummy/live. Set explicitly for each environment.
# local | test | staging | production. Unknown is intentional until configured.
# D-17 database commands read .env.validation.local, never this app's .env.local.
CHAIRMAN_ENV=unknown

# --- Supabase (Phase 1) -------------------------------------------------
# 프로젝트 생성 후 Chairman이 직접 채운다. 실제 값은 커밋하지 않는다(.env.local 만 사용).
# Dashboard > Project Settings > API 에서 그대로 복사한다.

# 프로젝트 URL. 예: https://xxxxxxxxxxxx.supabase.co
# 끝에 /rest/v1 을 붙이지 않는다 — SDK가 알아서 붙인다. 붙이면 /rest/v1/rest/v1 로 나간다.
NEXT_PUBLIC_SUPABASE_URL=

# publishable key (sb_publishable_...). 구형 프로젝트는 anon key(JWT)가 같은 자리에 들어간다.
# 브라우저에 노출돼도 되는 값이다. 행 단위 접근은 전부 RLS(supabase/migrations/0002_rls.sql)가 판정한다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# DB 직접 접속 비밀번호. 승인된 원격 릴리스 전용이며 로컬 검증에는 사용하지 않는다.
# 애플리케이션 런타임은 이 값을 쓰지 않는다(05_Architecture 6. Production DB 직접 접근 금지).
SUPABASE_DB_PASSWORD=

# service_role key는 이 프로젝트에 없다.
# 야간 AI Job(CH-045~048)은 권한 매트릭스의 AI Agent 역할로 인증해서 RLS 안에서 돈다.
# 자세한 이유는 CLAUDE.md 데이터 원칙 참고.

# --- 야간 AI 브리핑 (Phase 3-A) ------------------------------------------
# /api/cron/night-brief. 매일 07:00 KST(vercel.json 22:00 UTC)에 돈다. 서버 전용 — NEXT_PUBLIC_ 을 붙이지 않는다.

# supabase/bootstrap/0005_ai_agent.sql 로 role=AIAgent를 붙인 계정. Job은 이 계정으로 로그인해 RLS 안에서 읽고 쓴다.
AI_AGENT_EMAIL=
AI_AGENT_PASSWORD=

# Anthropic API 키와 모델. AI_MODEL이 비면 claude-sonnet-4-5.
ANTHROPIC_API_KEY=
AI_MODEL=

# Vercel Cron이 Authorization: Bearer <값> 으로 실어 보낸다. 16자 이상 무작위 문자열.
CRON_SECRET=

# --- 카카오 아침 알림 (Phase 3-C) ----------------------------------------
# 야간 Job의 마지막 단계가 카카오톡 '나에게 보내기'로 브리핑 한 줄을 보낸다.
# 전부 서버 전용이다 — NEXT_PUBLIC_ 을 붙이면 REST API 키가 빌드 산출물에 박혀 브라우저로 나간다.

# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > REST API 키.
KAKAO_REST_API_KEY=

# 카카오 콘솔의 [카카오 로그인 > Redirect URI]에 등록한 값과 **한 글자도 달라서는 안 된다**.
# 요청 호스트에서 유도하지 않는 이유: Vercel Preview는 배포마다 호스트가 바뀌는데
# 등록된 URI는 고정된 둘(production, localhost)뿐이라 유도하면 Preview에서 KOE006이 난다.
#   production  https://chairman-os-eosin.vercel.app/api/kakao/callback
#   로컬        http://localhost:3000/api/kakao/callback
KAKAO_REDIRECT_URI=

# 카톡 메시지 안의 '전문 보기'가 가리킬 곳. 끝에 / 를 붙이지 않는다.
# Cron에는 요청이 없어 호스트를 알 방법이 이 값뿐이다.
#   production  https://chairman-os-eosin.vercel.app
#   로컬        http://localhost:3000
APP_BASE_URL=

# 2단계 인증 강제(Executive 이상은 aal2 세션이어야 들어간다). 기본 false — 등록(/mfa)만 열려 있다.
# 회장이 TOTP를 등록한 뒤 Vercel Production에 true를 넣고 Redeploy한다. docs/OPERATIONS.md 3-1절 3번.
MFA_ENFORCE=false

# 카카오 콘솔 [보안]에서 Client Secret을 '사용함'으로 켰을 때만 채운다. 안 켰으면 비워 둔다.
KAKAO_CLIENT_SECRET=

# --- Integration 계정 (예약) ------------------------------------------------
# Phase 2-B에서 ECOUNT API 동기화를 걷어냈다. 지금 이 두 값을 읽는 코드는 없다.
# supabase/bootstrap/0006_integration.sql 로 role=Integration을 붙인 계정. DY ECOUNT 엑셀 업로드 블록에서 쓸지 정한다.
INTEGRATION_EMAIL=
INTEGRATION_PASSWORD=

# --- Staging (별도 Supabase 프로젝트) --------------------------------------
# 이 파일의 staging 사본은 `.env.staging.local`이다. `.env*.local`이 .gitignore에 있으므로 커밋되지 않는다.
# `npm run db:push:staging`이 그 파일만 읽는다 — `.env.local`(production)은 읽지 않는다.
#
# 만드는 법: `.env.local`을 복사한 뒤 아래 4줄을 staging 값으로 **교체**한다. 덧붙이면 안 된다 —
# 같은 키가 두 번 있으면 마지막 줄이 조용히 대상을 정한다. 가드가 중복과 production 프로젝트 ref를
# 발견하면 push를 거부한다(scripts/db-safety.mjs `assertStagingFile`).
#
#   CHAIRMAN_ENV=staging
#   NEXT_PUBLIC_SUPABASE_URL=https://itpenmxyracfhyormcep.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=  (staging 프로젝트의 publishable key)
#   SUPABASE_DB_PASSWORD=           (staging 프로젝트의 DB 비밀번호)
#
# 나머지 값(AI_AGENT_*, INTEGRATION_*, CRON_SECRET, ANTHROPIC_API_KEY)은 staging 전용으로 따로 발급한다.
# production과 같은 값을 쓰면 환경 분리가 아니다 — push 스크립트가 같은 값을 발견하면 경고한다
# (docs/OPERATIONS.md 9절 1번).
