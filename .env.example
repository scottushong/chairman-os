# dummy | live
# dummy 일 때만 화면에 DUMMY DATA 뱃지가 뜬다. 실데이터가 붙으면 live 로 바꾼다.
# live 인데 아래 Supabase 키가 비어 있으면 앱이 시작 시 에러를 던진다(조용히 dummy로 떨어지지 않는다).
NEXT_PUBLIC_DATA_MODE=dummy

# Deployment identity, independent of dummy/live. Set explicitly for each environment.
# local | test | staging | production. Unknown is intentional until configured.
# D-17 database commands read .env.validation.local, never this app's .env.local.
CHAIRMAN_ENV=unknown

# --- Supabase (Phase 1) -------------------------------------------------
# 프로젝트 생성 후 Chairman이 직접 채운다. 실제 값은 커밋하지 않는다(.env.local 만 사용).
# Dashboard > Project Settings > API 에서 그대로 복사한다.

# 프로젝트 URL. 예: https://xxxxxxxxxxxx.supabase.co
# 끝에 /rest/v1 을 붙이지 않는다 — SDK가 알아서 붙인다. 붙이면 /rest/v1/rest/v1 로 나간다.
NEXT_PUBLIC_SUPABASE_URL=

# publishable key (sb_publishable_...). 구형 프로젝트는 anon key(JWT)가 같은 자리에 들어간다.
# 브라우저에 노출돼도 되는 값이다. 행 단위 접근은 전부 RLS(supabase/migrations/0002_rls.sql)가 판정한다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# DB 직접 접속 비밀번호. 승인된 원격 릴리스 전용이며 로컬 검증에는 사용하지 않는다.
# 애플리케이션 런타임은 이 값을 쓰지 않는다(05_Architecture 6. Production DB 직접 접근 금지).
SUPABASE_DB_PASSWORD=

# service_role key는 이 프로젝트에 없다.
# 야간 AI Job(CH-045~048)은 권한 매트릭스의 AI Agent 역할로 인증해서 RLS 안에서 돈다.
# 자세한 이유는 CLAUDE.md 데이터 원칙 참고.

# --- 야간 AI 브리핑 (Phase 3-A) ------------------------------------------
# /api/cron/night-brief. 매일 23:00 KST(vercel.json 14:00 UTC)에 돈다. 서버 전용 — NEXT_PUBLIC_ 을 붙이지 않는다.

# supabase/bootstrap/0005_ai_agent.sql 로 role=AIAgent를 붙인 계정. Job은 이 계정으로 로그인해 RLS 안에서 읽고 쓴다.
AI_AGENT_EMAIL=
AI_AGENT_PASSWORD=

# Anthropic API 키와 모델. AI_MODEL이 비면 claude-sonnet-4-5.
ANTHROPIC_API_KEY=
AI_MODEL=

# Vercel Cron이 Authorization: Bearer <값> 으로 실어 보낸다. 16자 이상 무작위 문자열.
CRON_SECRET=

# --- ECOUNT 동기화 (Phase 2-A) -------------------------------------------
# 비우면 mock이다. mock은 화면(dummy)용 원장만 만들고 live DB에는 절대 쓰지 않는다(lib/ecount/sync.ts).
# 회사(ECOUNT 회사코드)마다 한 줄. 서버 전용 — NEXT_PUBLIC_ 을 붙이지 않는다. test=true면 sboapi(테스트 서버).
# 형식이 틀리면 mock으로 떨어지지 않고 동기화가 멈춘다.
# 예: [{"business_id":"biz_dy","com_code":"123456","user_id":"API_USER","api_cert_key":"...","zone":"CB","test":true}]
# 주의: 공개 OAPI에 전표·계정과목·마감 조회 API가 없다. 키를 넣으면 로그인까지 확인하고 원장은 'unsupported'로 보고한다(DEFERRED D-19).
ECOUNT_COMPANIES=

# supabase/bootstrap/0006_integration.sql 로 role=Integration을 붙인 계정. 동기화가 이 계정으로 로그인해 RLS 안에서 쓴다.
# AI_AGENT 계정을 재사용하지 않는다 — 0013이 Agent의 쓰기를 ai_night_outputs로 막는다.
ECOUNT_SYNC_EMAIL=
ECOUNT_SYNC_PASSWORD=
